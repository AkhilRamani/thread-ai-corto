# Use this exact origin in the browser and in your GitHub OAuth App settings.
APP_URL=http://127.0.0.1:3000
# Callback: http://127.0.0.1:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# At least 32 random characters. Generate locally: openssl rand -base64 48
SESSION_PASSWORD=
