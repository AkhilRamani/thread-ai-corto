# Exact browser origin; production must use HTTPS.
APP_URL=http://127.0.0.1:3000
# GitHub OAuth App callback: ${APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# At least 32 random characters. Generate locally: openssl rand -base64 48
SESSION_PASSWORD=
# Notion PUBLIC connection with Read content only.
# Callback: ${APP_URL}/api/auth/notion/callback
# API version pinned in server/notion.ts: 2026-03-11
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Server-only. Required for live investigation/impact, not sources or recorded example.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
